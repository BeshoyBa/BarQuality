rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Contenuti del sito: li legge chiunque, li scrive SOLO l'amministratore
    // (riconosciuto dall'UID oppure dall'email dell'account).
    match /site/{docId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && (request.auth.uid == "K6s09xCSP5WGaHLX990crsaOXYn1"
            || request.auth.token.email == "beshoyamir321@gmail.com")
        && request.resource.data.keys().hasOnly(['json', 'updatedAt', 'by'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
      allow delete: if false;
    }

    // Tutto il resto è chiuso.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
